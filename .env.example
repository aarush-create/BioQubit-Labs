# ---------------------------------------------------------------------------
# FRONTEND  (Vercel > Project > Settings > Environment Variables)
# ---------------------------------------------------------------------------
# No trailing slash. Vite bakes this in AT BUILD TIME, so after changing it you
# must redeploy — saving the variable alone does nothing.
VITE_API_URL=https://your-service.onrender.com


# ---------------------------------------------------------------------------
# BACKEND  (Render > Service > Environment)
# ---------------------------------------------------------------------------
# Must match your Vercel URL exactly. A mismatch here is the usual cause of the
# red "Backend unavailable" banner on a deployed site that works locally.
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Copilot. Without a key, /copilot returns 503 and the UI says so.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# Quantum backend. default.qubit is the PennyLane simulator.
# Set to qiskit.aer only if pennylane-qiskit is installed.
QVIRA_BACKEND=default.qubit
QVIRA_SHOTS=2048

# NCBI politeness. Optional, but an API key raises the rate limit from
# 3 to 10 requests/second. Used by build_panel.py and sentinel.py.
NCBI_API_KEY=
NCBI_EMAIL=you@example.com

# Sentinel refresh is DISABLED by default: this host's filesystem is ephemeral,
# so a refresh in production is lost on restart. Build the cache locally with
# `python sentinel.py` and commit sentinel_cache.json. Set to 1 to override.
ALLOW_SENTINEL_REFRESH=0
